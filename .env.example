# App credentials: Partner/Dev Dashboard -> your app -> Client credentials
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# One line per environment (any NAME works). Blank lines are ignored.
SHOPIFY_STORE_PROD=
SHOPIFY_STORE_STAGE=

# Optional overrides
# SHOPIFY_SCOPES=read_products,write_products,read_orders
# SHOPIFY_REDIRECT_URI=http://localhost:3000/callback
# SHOPIFY_CLIENT_ID_STAGE=      (if staging uses a different app)
# SHOPIFY_CLIENT_SECRET_STAGE=

# Written by get_access_token.py
# SHOPIFY_ACCESS_TOKEN_PROD / SHOPIFY_ACCESS_TOKEN_STAGE
# SHOPIFY_STORE / SHOPIFY_ACCESS_TOKEN   (active env, read by other scripts)
